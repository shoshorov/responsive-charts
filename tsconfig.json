{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES6", "DOM"],
    "strict": true,
    "moduleResolution": "node",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma/plugin-typings"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
